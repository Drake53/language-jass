{
  "name": "language-jass",
  "displayName": "JASS",
  "description": "TextMate grammar for JASS, the Warcraft III scripting language.",
  "version": "1.0.0",
  "publisher": "Drake53",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Drake53/language-jass"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "jass",
        "aliases": [
          "JASS",
          "jass"
        ],
        "extensions": [
          ".j",
          ".ai",
          ".jass"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jass",
        "scopeName": "source.jass",
        "path": "./syntaxes/jass.tmLanguage.json"
      }
    ]
  }
}
